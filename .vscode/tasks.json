{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mi Box: Build & Deploy",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/deploy-tv.sh"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Mi Box: Install Last Build",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/deploy-tv.sh", "--no-build"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Mi Box: Build & Deploy Preview",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/deploy-tv.sh", "--preview"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Mi Box: App Logs",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/deploy-tv.sh", "--logs"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
